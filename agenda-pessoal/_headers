/*
  # Força HTTPS de ponta a ponta (1 ano, incluindo subdomínios)
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Protege contra Clickjacking (impede iframes não autorizados)
  X-Frame-Options: DENY

  # Impede interpretação errada de MIME types
  X-Content-Type-Options: nosniff

  # Proteção de privacidade de tráfego
  Referrer-Policy: strict-origin-when-cross-origin

  # Desativa recursos desnecessários do navegador
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

  # Política de Segurança de Conteúdo (CSP Nível A+)
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none';
